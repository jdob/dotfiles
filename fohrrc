# == Local Environment ==

fohr-env-local () {
  source ~/Code/fohr/etc/local-backend
}

fohr-env-dev () {
  source ~/Code/fohr/etc/local-backend-dev-db
}

# == Backend Tests ==

fohr-unit-tests () {
  if [ "$EXTRA_ENV" != "local-db" ]; then
    echo "EXTRA_ENV must be set to 'local-db' to run fohr-unit-tests"
    return 1
  fi
  bb bundle exec rspec --format d --tag ~passing:false
}

fohr-run-test () {
  bb bundle exec rspec "$@"
}

fohr-ci-tests () {
  bb make ci-test
}

fohr-docker-test-cleanup () {
  COMPOSE_PROJECT_NAME=fohr-backend-ci docker compose -f docker-compose.ci.yml down
}

# == Formatting ==

fohr-rubocop () {
  bb bundle exec standardrb "$@"
}

fohr-rubocop-changed () {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "Not inside a git repository." >&2; return 1; }

  local files=()
  while IFS= read -r line; do
    local git_status=${line:0:2}
    local file_path=${line:3}
    case "$git_status" in
      *A*|*M*)
        case "$file_path" in
          *.rb|*.rake|*.gemspec|Gemfile|Rakefile) files+=("$file_path") ;;
        esac
        ;;
    esac
  done < <(git -C "$root" status --porcelain=v1)

  if [[ ${#files[@]} -eq 0 ]]; then
    echo "No added or modified Ruby files to lint."
    return 0
  fi

  (cd "$root" && bb bundle exec standardrb "${files[@]}")
}

fohr-sorbet () {
  bb bundle exec srb tc "$@"
}

fohr-tapioca () {
  bb bundle exec tapioca dsl
}

fohr-refresh () {
  docker compose up -d database redis elasticsearch s3mock cdn-proxy
  docker compose run --rm web bin/rails db:migrate
  docker compose run --rm --entrypoint bash web -lc 'bundle exec tapioca dsl'
  bb echo "Refresh Completed"
}

# == Container Start ==

fohr-web-up () {
  docker compose up --no-deps web
}

fohr-infra-up() {
  docker compose up database cdn-proxy redis elasticsearch s3mock
}

# == VPN ==

fohr-warp-up () {
  sudo systemctl start warp-svc
  sleep 3
  warp-cli connect
}

fohr-warp-down () {
  warp-cli disconnect
  sudo cp /home/jdob/Code/fohr/warp/resolv.home /etc/resolv.conf
  sudo systemctl stop warp-svc
}

# == Git Shortcuts ==

fohr-gemfile-skip () {
  git update-index --skip-worktree Gemfile*
}

fohr-gemfile-no-skip () {
  git update-index --no-skip-worktree Gemfile*
}

# == Connect to Docker Containers ==

fohr-connect-db () {
  docker exec -u 0 -it fohr-backend-database-1 bash
}

fohr-connect-web () {
  docker exec -u 0 -it fohr-backend-web-1 bash
}

fohr-console () {
  docker compose exec web bin/rails c
}
